@inherits LayoutComponentBase

<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>

<form id="logout-form" method="post" action="/account/logout" style="display:none"></form>

<RadzenLayout>
    <RadzenHeader class="app-header">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0" Style="width: 100%;">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
                <RadzenLabel Text="Clearscan" />
            </RadzenStack>
            <RadzenProfileMenu class="rz-mr-4">
                <Template>
                    <RadzenIcon Icon="account_circle" />
                </Template>
                <ChildContent>
                    <RadzenProfileMenuItem Text="@UserName" Style="cursor: default; font-weight: 600; pointer-events: none;" />
                    <RadzenProfileMenuItem>
                        <Template>
                            <button type="submit" form="logout-form" class="rz-logout-button">
                                <i class="notranslate rzi rz-navigation-item-icon" aria-hidden="true">logout</i>
                                <span class="rz-navigation-item-text">Abmelden</span>
                            </button>
                        </Template>
                    </RadzenProfileMenuItem>
                </ChildContent>
            </RadzenProfileMenu>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar Responsive="false" class="@(sidebarExpanded ? "" : "sidebar-collapsed")">
        <RadzenPanelMenu DisplayStyle="MenuItemDisplayStyle.IconAndText" ShowArrow="false">
            <RadzenPanelMenuItem Text="Overview" Icon="home" />
            <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" />
            <RadzenPanelMenuItem Text="Statistics" Icon="bar_chart" Path="/statistics" />
            <RadzenPanelMenuItem Text="Grid" Icon="grid_on">
                <RadzenPanelMenuItem Text="Simple Grid" Path="/grid/simple-grid" />
                <RadzenPanelMenuItem Text="Pivot Grid" Path="/grid/pivot" />
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="UI Fundamentals" Icon="auto_awesome">
                <RadzenPanelMenuItem Text="Themes" Icon="color_lens" />
                <RadzenPanelMenuItem Text="Colors" Icon="invert_colors" />
            </RadzenPanelMenuItem>
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>


<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    bool sidebarExpanded = true;
    string? UserName;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            UserName = authState.User.Identity?.Name;
        }
    }
}