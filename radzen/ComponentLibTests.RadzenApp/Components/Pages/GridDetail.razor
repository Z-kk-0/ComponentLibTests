@page "/grid/detail/{Id:int}"

<PageTitle>Match Detail</PageTitle>

@if (matchResult is not null)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H3" class="rz-mb-0">@Title</RadzenText>
        <RadzenBadge Text="@($"{matchResult.MatchingValue:0}%")" BadgeStyle="@MatchBadgeStyle" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mb-4">
        <RadzenButton Text="True Positive" Icon="search" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
        <RadzenButton Text="False Positive" Icon="search" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
        <RadzenButton Text="Generate PDF" Icon="description" ButtonStyle="ButtonStyle.Success" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mb-2">
        <RadzenButton Text="Match History" Icon="history" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
        <RadzenButton Text="Notification History" Icon="notifications" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
    </RadzenStack>

    <RadzenDataGrid Data="@detailRows" TItem="DetailRow">
        <Columns>
            <RadzenDataGridColumn TItem="DetailRow" Property="Label" Title="Label" />
            <RadzenDataGridColumn TItem="DetailRow" Title="Extern Profile">
                <Template Context="row">
                    @if (row.IsOrganisation)
                    {
                        <RadzenBadge Text="@row.ExternValue" BadgeStyle="BadgeStyle.Warning" Visible="@(!string.IsNullOrEmpty(row.ExternValue))" />
                    }
                    else
                    {
                        @row.ExternValue
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="DetailRow" Title="Intern Profile">
                <Template Context="row">
                    @if (row.IsOrganisation)
                    {
                        <RadzenBadge Text="@row.InternValue" BadgeStyle="BadgeStyle.Warning" Visible="@(!string.IsNullOrEmpty(row.InternValue))" />
                    }
                    else
                    {
                        @row.InternValue
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private IDbContextFactory<AppDbContext> DbFactory { get; set; } = default!;

    private EntityMatchResult? matchResult;
    private List<DetailRow> detailRows = new();

    private string Title => $"{matchResult?.ProfileExtern?.Entity} - {matchResult?.EntityInternEntity?.Entity}";

    private BadgeStyle MatchBadgeStyle => matchResult switch
    {
        { MatchingValue: >= 80 } => BadgeStyle.Danger,
        { MatchingValue: >= 50 } => BadgeStyle.Warning,
        _ => BadgeStyle.Info
    };

    private class DetailRow
    {
        public string Label { get; set; } = "";
        public string? ExternValue { get; set; }
        public string? InternValue { get; set; }
        public bool IsOrganisation { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        matchResult = await db.EntityMatchResults
            .Include(m => m.ProfileExtern).ThenInclude(p => p!.EntitySource)
            .Include(m => m.ProfileExtern).ThenInclude(p => p!.ProfileRiskLevel)
            .Include(m => m.EntityInternEntity).ThenInclude(e => e!.EntityInternRiskLevel)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (matchResult is null)
        {
            return;
        }

        var externProfile = matchResult.ProfileExtern;
        var intern = matchResult.EntityInternEntity;

        detailRows = new List<DetailRow>
        {
            new() { Label = "#", ExternValue = externProfile is null ? null : $"{externProfile.Id} ({externProfile.EntitySource?.Name})", InternValue = intern?.Id.ToString() },
            new() { Label = "Is Active", ExternValue = null, InternValue = intern is null ? null : (intern.Active ? "1" : "0") },
            new() { Label = "Risk Level", ExternValue = externProfile?.ProfileRiskLevel?.RiskLevel, InternValue = intern?.EntityInternRiskLevel is null ? null : $"{intern.EntityInternRiskLevel.RiskLevel} ({intern.EntityInternRiskLevel.Sort:D2})" },
            new() { Label = "Label", ExternValue = null, InternValue = intern?.Label },
            new() { Label = "Organisation", ExternValue = externProfile?.Entity, InternValue = intern?.Entity, IsOrganisation = true },
            new() { Label = "Nationality", ExternValue = externProfile?.Nationality, InternValue = null },
            new() { Label = "Countries", ExternValue = null, InternValue = null },
            new() { Label = "Locations", ExternValue = null, InternValue = null },
            new() { Label = "Remarks", ExternValue = externProfile?.Remarks, InternValue = null },
        };
    }
}
