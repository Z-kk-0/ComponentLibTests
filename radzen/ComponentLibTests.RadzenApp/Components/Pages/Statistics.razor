@page "/statistics"

<PageTitle>Statistics</PageTitle>

<RadzenText TextStyle="TextStyle.H3" class="stat-page-title rz-mb-4">Current Matches</RadzenText>

<RadzenRow Gap="1rem" class="rz-mb-4">
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenStack Gap="1rem">
            <RadzenCard class="stat-card stat-card-highlight">
                <div class="d-flex-end"><RadzenIcon Icon="info" IconColor="var(--rz-secondary)" /></div>
                <div class="stat-number">@totalCount</div>
                <RadzenText TextStyle="TextStyle.Body1"  class="rz-text-align-center stat-label">Matches Overall</RadzenText>
            </RadzenCard>
            <RadzenCard class="stat-card">
                <div class="d-flex-end"><RadzenIcon Icon="info" IconColor="var(--rz-secondary)" /></div>
                <div class="stat-number">@newThisMonthCount</div>
                <RadzenText TextStyle="TextStyle.Body1" class="rz-text-align-center stat-label">New this month</RadzenText>
            </RadzenCard>
        </RadzenStack>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="4">
        <RadzenCard class="stat-list-card">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Status</RadzenText>
                <RadzenIcon Icon="info" IconColor="var(--rz-secondary)" />
            </RadzenStack>
            @foreach (var item in statusCounts)
            {
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="stat-list-row">
                    <span>@item.Label</span>
                    <RadzenBadge Text="@item.Count.ToString()" BadgeStyle="BadgeStyle.Info" />
                </RadzenStack>
            }
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="5">
        <RadzenCard class="stat-list-card">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Sources</RadzenText>
                <RadzenIcon Icon="info" IconColor="var(--rz-secondary)" />
            </RadzenStack>
            @foreach (var item in sourceCounts)
            {
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="stat-list-row">
                    <span>@item.Label</span>
                    <RadzenBadge Text="@item.Count.ToString()" BadgeStyle="BadgeStyle.Info" />
                </RadzenStack>
            }
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenText TextStyle="TextStyle.H3" class="rz-mb-2">All Matches</RadzenText>

<RadzenDataGrid Data="@matches" TItem="EntityMatchResult" IsLoading="@isLoading"
                AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true">
    <Columns>
        <RadzenDataGridColumn TItem="EntityMatchResult" Property="Id" Title="Id" Width="90px" />
        <RadzenDataGridColumn TItem="EntityMatchResult" Property="ProfileExtern.Entity" Title="Extern entity">
            <Template Context="row">@row.ProfileExtern?.Entity</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EntityMatchResult" Property="EntityInternEntity.Entity" Title="Intern entity">
            <Template Context="row">@row.EntityInternEntity?.Entity</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EntityMatchResult" Property="MatchingValue" Title="Matching value">
            <Template Context="row">
                <RadzenBadge Text="@($"{row.MatchingValue:0}")" BadgeStyle="@MatchBadgeStyle(row.MatchingValue)" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EntityMatchResult" Property="EntityMatchStatus.Status" Title="Status">
            <Template Context="row">
                <RadzenBadge Text="@row.EntityMatchStatus?.Status" BadgeStyle="BadgeStyle.Light" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EntityMatchResult" Property="ProfileExtern.EntitySource.Name" Title="Source">
            <Template Context="row">@row.ProfileExtern?.EntitySource?.Name</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="EntityMatchResult" Property="Updated" Title="Updated date" FormatString="{0:dd.MM.yyyy HH:mm}" />
        <RadzenDataGridColumn TItem="EntityMatchResult" Property="Created" Title="Created date" FormatString="{0:dd.MM.yyyy HH:mm}" />
        <RadzenDataGridColumn TItem="EntityMatchResult" Title="" Sortable="false" Filterable="false" Width="70px">
            <Template Context="row">
                <RadzenButton Icon="arrow_forward" ButtonStyle="ButtonStyle.Secondary" Click="@(() => NavigationManager.NavigateTo($"/grid/detail/{row.Id}"))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Inject] private IDbContextFactory<AppDbContext> DbFactory { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private int totalCount;
    private int newThisMonthCount;
    private List<CountItem> statusCounts = new();
    private List<CountItem> sourceCounts = new();
    private List<EntityMatchResult> matches = new();
    private bool isLoading = true;

    private class CountItem
    {
        public string Label { get; set; } = "";
        public int Count { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        totalCount = await db.EntityMatchResults.CountAsync();

        var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        newThisMonthCount = await db.EntityMatchResults.CountAsync(m => m.Created >= monthStart);

        statusCounts = await db.EntityMatchResults
            .GroupBy(m => m.EntityMatchStatus!.Status)
            .Select(g => new CountItem { Label = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToListAsync();

        sourceCounts = await db.EntityMatchResults
            .GroupBy(m => m.ProfileExtern!.EntitySource!.Name)
            .Select(g => new CountItem { Label = g.Key, Count = g.Count() })
            .OrderByDescending(x => x.Count)
            .ToListAsync();

        matches = await db.EntityMatchResults
            .Include(m => m.ProfileExtern).ThenInclude(p => p!.EntitySource)
            .Include(m => m.EntityInternEntity)
            .Include(m => m.EntityMatchStatus)
            .OrderByDescending(m => m.Created)
            .ToListAsync();

        isLoading = false;
    }

    private BadgeStyle MatchBadgeStyle(double value) => value switch
    {
        >= 80 => BadgeStyle.Danger,
        >= 50 => BadgeStyle.Warning,
        _ => BadgeStyle.Info
    };
}
